From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <unica@example.invalid>
Date: Mon, 17 Aug 2026 00:00:00 -0300
Subject: [PATCH] a52sxq: optionally remove HFR brightness thresholds

Rebased from ArtisanROM's HFR tweak. The values below are the A52s
configuration values, not Exynos values.

---
 smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali b/smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali
index 0000000..1111111 100644
--- a/smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali
+++ b/smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali
@@ -386,1 +386,1 @@
-    const-string v0, "SEAMLESS_BRT: 89,91"
+    const-string v0, "SEAMLESS_BRT: "
@@ -441,1 +441,1 @@
-    const-string v0, "SEAMLESS_LUX: 200,2500"
+    const-string v0, "SEAMLESS_LUX: "
@@ -584,1 +584,1 @@
-    .locals 5
+    .locals 4
@@ -596,1 +596,1 @@
-    const-string v3, "89,91"
+    const-string v3, ""
@@ -598,1 +598,1 @@
-    const-string v4, "200,2500"
+    const-string v3, ""
@@ -600,1 +600,1 @@
-    invoke-direct {v0, v3, v4, v1, v2}, Lcom/samsung/android/hardware/display/RefreshRateConfig$BrightnessThreshold;-><init>(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V
+    invoke-direct {v0, v3, v3, v1, v2}, Lcom/samsung/android/hardware/display/RefreshRateConfig$BrightnessThreshold;-><init>(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V
